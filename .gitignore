# ---- 环境 / 密钥 ----
.env

# ---- Python ----
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# ---- 运行数据（data/ 下内容不提交，仅放行预洗好的题库 JSON）----
# 注意必须用 data/* 而非 data/：父目录被整体排除时，! 例外不会生效
data/*
!data/faqs.json

# ---- 数据采集与洗数管线（爬虫 / FAQ 源适配器 / 洗数脚本），不属于功能代码 ----
app/services/data_pipeline/
faq_sources.json

# ---- 编辑器 / IDE / 系统 ----
.DS_Store
.trae/
.idea/
.vscode/
