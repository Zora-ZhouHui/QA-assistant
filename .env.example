
# 大模型：阿里云百炼 qwen3.7-plus（OpenAI 兼容端点，https://dashscope.aliyuncs.com 仍可用）
# 模型 ID 必须小写；不要写成开源仓名 Qwen/Qwen3.7-Plus
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus

# 切到其它厂商示例（OpenAI 兼容即可）：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat

# 视觉（多模态）模型：用户上传截图后，先由它按场景指令（控制台报错/布局错位/
# 设计稿对比）把图解析成纯文本。控制台报错/布局错位再接入 kb_search + web_search
# 的 RAG 链路；设计稿对比为"直接作答"，视觉对比结果即最终答案，不检索本地库/联网。
# 留空 = 未启用多模态，带图请求会被明确拦截提示（不静默降级）。走 OpenAI 兼容
# image_url 格式（支持 base64 dataURL），换厂商只改下面三项（BaseURL/Key 留空则复用
# 上面的 LLM_* 同一端点）。qwen3.7-plus 原生支持图文输入，此处复用同一模型与端点。
VISION_MODEL=qwen3.7-plus
VISION_BASE_URL=
VISION_API_KEY=

# 单张图尺寸上限（按 dataURL 字符数计；前端已压缩，这里是双保险）
MAX_IMAGE_BYTES=5242880

TAVILY_API_KEY=
SEARCH_PROVIDER=tavily
SEARCH_MAX_RESULTS=5
# basic=1 credit/次；advanced=2 credits，正文更全
SEARCH_DEPTH=advanced
# 地域限定，留空则不限制
SEARCH_COUNTRY=china
# 单次问答 kb_search + web_search 所有工具调用的总轮数上限（防失控、控延迟）
SEARCH_MAX_ROUNDS=3
# 前端联网开关默认值
WEB_SEARCH_DEFAULT=true

# 检索管线（app/services/retrieval/）
#   dense  = 纯向量单路（默认：本轮四级难度评测证明的最强路径）
#   hybrid = 稠密 + BM25 稀疏：稀疏只负责扩大候选池，不改排序，
#            需配合 RERANK_ENABLED=true 才有意义（扩池是为给重排器更多候选）
#   注：重排关闭时 hybrid 与 dense 对 top_k 结果等价，默认走 dense 避免无谓开销
RETRIEVAL_MODE=dense
RETRIEVAL_CANDIDATE_K=20

# 重排（Cross-Encoder）：对全部候选池做精排，代价是额外延迟。
# 模型缺失 / 加载失败时自动降级为"不重排"（记日志），回退稠密序，不阻断检索。
# 默认关闭：评测显示 bge-reranker-base 让 L4 Recall@1 从 84% 掉到 80.5%（负收益），
# 更强的 v2-m3 在本机 CPU 上评测超时未跑完。详见 README「检索管线演进」。
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
